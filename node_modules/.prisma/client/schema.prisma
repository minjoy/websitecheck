// Prisma 스키마 - 마켓플레이스 딜 사이트

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// User 모델
// ==========================================
model User {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified") @db.TinyInt
  isAdmin       Boolean  @default(false) @map("is_admin") @db.TinyInt

  // 프로필
  gender              Gender?        @map("gender")
  ageGroup            AgeGroup?      @map("age_group")
  lifeStage           LifeStage?     @map("life_stage")
  residenceType       ResidenceType? @map("residence_type")
  regionType          RegionType?    @map("region_type")
  incomeLevel         IncomeLevel?   @map("income_level")
  jobIndustry         JobIndustry?   @map("job_industry")
  jobRole             JobRole?       @map("job_role")
  workStyle           WorkStyle?     @map("work_style")
  dailyPattern        DailyPattern?  @map("daily_pattern")
  profileCompletedAt  DateTime?      @map("profile_completed_at")
  suppressProfilePopup Boolean       @default(false) @map("suppress_profile_popup") @db.TinyInt
  isBlacklisted       Boolean        @default(false) @map("is_blacklisted") @db.TinyInt

  // 타임스탬프
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // 관계
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  products                Product[]
  favorites               Favorite[]
  keywordAlerts           KeywordAlert[]
  userActions             UserAction[]
  userCategoryWeights     UserCategoryWeight[]
  productReports          ProductReport[]

  @@index([email])
  @@map("users")
}

// ==========================================
// EmailVerificationToken 모델
// ==========================================
model EmailVerificationToken {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}

// ==========================================
// PasswordResetToken 모델
// ==========================================
model PasswordResetToken {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// ==========================================
// ProductCategory 모델
// ==========================================
model ProductCategory {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  parentId     BigInt?  @map("parent_id") @db.UnsignedBigInt
  name         String   @db.VarChar(100)
  code         String   @unique @db.VarChar(50)
  depth        Int      @default(0)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryHierarchy")

  categoryKeywords      CategoryKeyword[]
  productCategoriesMaps ProductCategoryMap[]
  userCategoryWeights   UserCategoryWeight[]

  @@index([parentId])
  @@map("product_categories")
}

// ==========================================
// CategoryKeyword 모델
// ==========================================
model CategoryKeyword {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId  BigInt      @map("category_id") @db.UnsignedBigInt
  keyword     String      @db.VarChar(100)
  weight      Float       @default(1.0)
  keywordType KeywordType @default(SECONDARY) @map("keyword_type")
  createdAt   DateTime    @default(now()) @map("created_at")

  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("category_keywords")
}

// ==========================================
// Product 모델
// ==========================================
model Product {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt?       @map("user_id") @db.UnsignedBigInt
  isGroupBuy      Boolean       @default(false) @map("is_group_buy") @db.TinyInt
  isAdminVerified Boolean       @default(false) @map("is_admin_verified") @db.TinyInt
  title           String        @db.VarChar(255)
  description     String?       @db.Text
  thumbnailUrl    String?       @map("thumbnail_url") @db.VarChar(500)
  externalUrl     String?       @map("external_url") @db.VarChar(500)
  normalPrice     Int           @default(0) @map("normal_price")
  salePrice       Int           @default(0) @map("sale_price")
  discountRate    Float         @default(0) @map("discount_rate")
  sourceSite      String?       @map("source_site") @db.VarChar(255)
  reviewCount     Int?          @map("review_count")
  rating          Float?        @db.Float
  pros            String?       @db.Text
  cons            String?       @db.Text
  summary         String?       @db.Text
  partnerLabel    String?       @map("partner_label") @db.VarChar(255)
  viewCount       Int           @default(0) @map("view_count")
  clickCount      Int           @default(0) @map("click_count")
  favoriteCount   Int           @default(0) @map("favorite_count")
  reportCount     Int           @default(0) @map("report_count")
  isHidden        Boolean       @default(false) @map("is_hidden") @db.TinyInt
  status          ProductStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  productCategoriesMaps ProductCategoryMap[]
  favorites             Favorite[]
  keywordAlertLogs      KeywordAlertLog[]
  userActions           UserAction[]
  productReports        ProductReport[]

  @@index([userId])
  @@index([status])
  @@fulltext([title])
  @@map("products")
}

// ==========================================
// ProductCategoryMap 모델
// ==========================================
model ProductCategoryMap {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId   BigInt   @map("product_id") @db.UnsignedBigInt
  categoryId  BigInt   @map("category_id") @db.UnsignedBigInt
  score       Float    @default(0)
  isPrimary   Boolean  @default(false) @map("is_primary") @db.TinyInt
  isSuggested Boolean  @default(true) @map("is_suggested") @db.TinyInt
  createdAt   DateTime @default(now()) @map("created_at")

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@map("product_categories_map")
}

// ==========================================
// Favorite 모델
// ==========================================
model Favorite {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

// ==========================================
// KeywordAlert 모델
// ==========================================
model KeywordAlert {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  keyword   String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active") @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywordAlertLogs KeywordAlertLog[]

  @@index([userId])
  @@map("keyword_alerts")
}

// ==========================================
// KeywordAlertLog 모델
// ==========================================
model KeywordAlertLog {
  id                  BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  keywordAlertId      BigInt              @map("keyword_alert_id") @db.UnsignedBigInt
  productId           BigInt              @map("product_id") @db.UnsignedBigInt
  notificationChannel NotificationChannel @default(EMAIL) @map("notification_channel")
  notifiedAt          DateTime            @default(now()) @map("notified_at")

  keywordAlert KeywordAlert @relation(fields: [keywordAlertId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([keywordAlertId])
  @@map("keyword_alert_logs")
}

// ==========================================
// UserAction 모델
// ==========================================
model UserAction {
  id         BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt     @map("user_id") @db.UnsignedBigInt
  actionType ActionType @map("action_type")
  productId  BigInt?    @map("product_id") @db.UnsignedBigInt
  createdAt  DateTime   @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("user_actions")
}

// ==========================================
// UserCategoryWeight 모델
// ==========================================
model UserCategoryWeight {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt   @map("user_id") @db.UnsignedBigInt
  categoryId       BigInt   @map("category_id") @db.UnsignedBigInt
  weight           Float    @default(0)
  lastCalculatedAt DateTime @default(now()) @map("last_calculated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@map("user_category_weights")
}

// ==========================================
// ProductReport 모델
// ==========================================
model ProductReport {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  reason    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("product_reports")
}

// ==========================================
// Enum 정의
// ==========================================

enum Gender {
  MALE
  FEMALE
  OTHER
  NO_ANSWER
}

enum AgeGroup {
  AGE_20S
  AGE_30S
  AGE_40S
  AGE_50S_PLUS
}

enum LifeStage {
  SINGLE
  COUPLE_NO_CHILD
  PARENTS_BABY_0_3
  PARENTS_CHILD_4_7
  PARENTS_CHILD_8_13
  MULTI_GENERATION
  OTHER
}

enum ResidenceType {
  ONE_ROOM
  APARTMENT
  HOUSE
  OFFICETEL
  DORM
  OTHER
}

enum RegionType {
  SEOUL_METRO
  METRO_CITY
  LOCAL_CITY
  RURAL
}

enum IncomeLevel {
  UNDER_2M
  IN_2_4M
  IN_4_6M
  IN_6_8M
  OVER_8M
  NO_ANSWER
}

enum JobIndustry {
  OFFICE_BUSINESS
  IT_DEV
  DESIGN_CREATIVE
  EDU_TEACHER
  MEDICAL_HEALTH
  SALES_SERVICE
  SELF_EMPLOYED
  STUDENT
  HOME_MAKER
  OTHER
}

enum JobRole {
  STAFF
  MANAGER
  EXECUTIVE
  FREELANCER
  OWNER
  OTHER
}

enum WorkStyle {
  FULL_REMOTE
  HYBRID
  ON_SITE
  SHIFT
  IRREGULAR
  OTHER
}

enum DailyPattern {
  MORNING_PERSON
  NIGHT_PERSON
  NO_PATTERN
}

enum KeywordType {
  CORE
  SECONDARY
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum NotificationChannel {
  EMAIL
}

enum ActionType {
  SIGNUP
  LOGIN
  PRODUCT_CREATED
  PRODUCT_VIEWED
  PRODUCT_CLICKED
  FAVORITED
  UNFAVORITED
}
