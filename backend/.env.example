# ==========================================
# 서버 설정
# ==========================================
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ==========================================
# 데이터베이스 (AWS RDS MySQL)
# ==========================================
DATABASE_URL="mysql://username:password@your-rds-endpoint:3306/marketplace_deals"
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_strong_password
DB_NAME=marketplace_deals

# ==========================================
# JWT 설정
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# 이메일 설정 (개발: Gmail SMTP)
# ==========================================
EMAIL_PROVIDER=smtp
# Gmail 사용 시
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM="마켓플레이스 딜 <no-reply@yourdomain.com>"

# ==========================================
# 이메일 설정 (프로덕션: AWS SES)
# ==========================================
# EMAIL_PROVIDER=ses
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# SES_FROM_EMAIL=no-reply@yourdomain.com

# ==========================================
# Redis (선택사항 - 캐싱용)
# ==========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# 보안 설정
# ==========================================
BCRYPT_SALT_ROUNDS=10
COOKIE_SECRET=your_cookie_secret_key

# CORS 허용 도메인
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# 파일 업로드 (S3 등)
# ==========================================
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=ap-northeast-2

# ==========================================
# 기타
# ==========================================
LOG_LEVEL=info
